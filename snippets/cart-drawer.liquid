<!-- Cart drawer simple markup -->
<aside class="cart-drawer" role="dialog" aria-hidden="true">
  <button class="close" aria-label="Close cart">✕</button>
  <h3>Your cart</h3>
  <div class="cart-items">
    <!-- Dynamic cart contents via Shopify Ajax or server-rendered cart snippets -->
    <p class="muted">Cart preview is unavailable in this demo. Use the cart page or integrate AJAX cart API.</p>
  </div>
  <div class="cart-footer">
    <a href="/cart" class="btn btn--accent">Checkout</a>
  </div>
</aside>
