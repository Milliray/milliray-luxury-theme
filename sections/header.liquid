<!-- Header section updated to prefer white logo for dark theme, and ensure nav text/icons are visible on dark background -->
<header class="site-header" role="banner">
  <div class="header-inner wrapper">
    <div class="brand-wrap">
      {% if section.settings.logo != blank %}
        <a class="brand" href="/">
          <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }} logo" style="height:48px; object-fit:contain">
        </a>
      {% else %}
        <a class="brand" href="/">
          {% if asset_url contains 'logo.custom--white.svg' %}
            <img src="{{ 'logo.custom--white.svg' | asset_url }}" alt="{{ shop.name }} logo" style="height:48px; display:block">
          {% else %}
            <img src="{{ 'logo.custom--white.svg' | asset_url }}" alt="{{ shop.name }} logo" style="height:48px; display:block">
          {% endif %}
        </a>
      {% endif %}
    </div>

    <nav class="main-nav" role="navigation" aria-label="Main menu">
      {% if section.blocks.size > 0 %}
        <ul class="menu">
          {% for block in section.blocks %}
            <li class="menu-item menu-item-block" data-block-id="{{ block.id }}">
              {% assign link = block.settings.link | default: '/' %}
              <a href="{{ link }}" class="menu-link">
                <span class="menu-title">{{ block.settings.title }}</span>
              </a>

              {% assign img_src = block.settings.image %}
              {% if img_src == blank %}
                {% assign lower = block.settings.title | downcase %}
                {% if lower contains 'men' %}
                  {% assign img_src = 'menu-men.svg' | asset_url %}
                {% elsif lower contains 'woman' or lower contains 'women' %}
                  {% assign img_src = 'menu-women.svg' | asset_url %}
                {% elsif lower contains 'access' or lower contains 'accessories' %}
                  {% assign img_src = 'menu-accessories.svg' | asset_url %}
                {% else %}
                  {% assign img_src = 'product-placeholder.svg' | asset_url %}
                {% endif %}
              {% else %}
                {% assign img_src = block.settings.image | img_url: '800x' %}
              {% endif %}

              <div class="menu-mega">
                <a href="{{ link }}">
                  <img src="{{ img_src }}" alt="{{ block.settings.title }}" />
                </a>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        {% if linklists.main-menu.links.size > 0 %}
          <ul class="menu">
            {% for link in linklists.main-menu.links %}
              <li class="menu-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <ul class="menu">
            <li class="menu-item">
              <a href="/collections/male">Men</a>
              <div class="menu-mega"><a href="/collections/male"><img src="{{ 'menu-men.svg' | asset_url }}" alt="Men"></a></div>
            </li>
            <li class="menu-item">
              <a href="/collections/female">Women</a>
              <div class="menu-mega"><a href="/collections/female"><img src="{{ 'menu-women.svg' | asset_url }}" alt="Women"></a></div>
            </li>
            <li class="menu-item">
              <a href="/collections/accessories">Accessories</a>
              <div class="menu-mega"><a href="/collections/accessories"><img src="{{ 'menu-accessories.svg' | asset_url }}" alt="Accessories"></a></div>
            </li>
          </ul>
        {% endif %}
      {% endif %}
    </nav>

    <div class="header-actions">
      <a class="search-link" href="/search">Search</a>
      <a class="cart-link open-cart" href="/cart">Cart</a>
    </div>

    <button class="mobile-toggle" aria-label="Toggle menu">☰</button>
  </div>
  {% render 'cart-drawer' %}
</header>
