<!-- Header section with primary navigation (uses uploaded logo if present, falls back to bundled logo.svg) -->
<header class="site-header" role="banner">
  <div class="header-inner wrapper">
    <div class="brand-wrap">
      {% if section.settings.logo != blank %}
        <a class="brand" href="/">
          <img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }} logo" style="height:42px; object-fit:contain">
        </a>
      {% else %}
        <a class="brand" href="/">
          <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }} logo" style="height:42px; display:block">
        </a>
      {% endif %}
    </div>

    <nav class="main-nav" role="navigation" aria-label="Main menu">
      <!-- Static primary navigation: Male, Female, Accessories -->
      <ul class="menu">
        <li class="menu-item"><a href="/collections/male">Male</a></li>
        <li class="menu-item"><a href="/collections/female">Female</a></li>
        <li class="menu-item"><a href="/collections/accessories">Accessories</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="search-link" href="/search">Search</a>
      <a class="cart-link" href="/cart">Cart</a>
    </div>

    <button class="mobile-toggle" aria-label="Toggle menu">☰</button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
