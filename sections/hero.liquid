<!-- Full-bleed hero with overlay and CTA, tuned for premium look -->
<section class="hero">
  <div class="hero-media">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: '2048x2048' }}" alt="{{ section.settings.heading }}">
    {% else %}
      <img src="{{ 'hero.svg' | asset_url }}" alt="{{ section.settings.heading }}">
    {% endif %}
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <p><a class="btn btn--accent" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a></p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero (premium)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Milliray Luxury" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Elevate your style" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero (premium)" }]
}
{% endschema %}
