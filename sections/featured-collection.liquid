<!-- Featured collection section -->
<section class="featured-collection wrapper">
  <h2>{{ section.settings.heading }}</h2>
  <div class="grid">
    {% assign collection_handle = section.settings.collection %}
    {% if collection_handle != blank %}
      {% assign collection = collections[collection_handle] %}
      {% for product in collection.products limit:4 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      <p>Add a collection to display featured products.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" }
  ],
  "blocks": [],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
